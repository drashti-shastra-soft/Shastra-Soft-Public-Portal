@{
    ViewData["Title"] = "SEO Services | ShastraSoft";
    ViewData["MetaDescription"] = "Top-ranked SEO services from ShastraSoft. On-page, off-page optimization, technical SEO for higher search rankings.";
    ViewData["MetaKeywords"] = "SEO services, search engine optimization, technical SEO, on-page SEO, off-page SEO, local SEO, ShastraSoft SEO";
}
<!-- Page Title -->
<div class="page-title">
    <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="Javascript:void(0);"><i class="bi bi-house"></i> Home</a></li>
                <li class="breadcrumb-item active current">SEO</li>
            </ol>
        </nav>
    </div>

    <div class="title-wrapper">
        <h1>SEO</h1>
        <p>SEO That Delivers Results You Can Measure</p>
    </div>
</div><!-- End Page Title -->

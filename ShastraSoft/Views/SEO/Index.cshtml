                                <div class="feature-item">
                                    <i class="bi bi-graph-up-arrow flex-shrink-0"></i>
                                    <div>
                                        <h5>Strategy Development</h5>
                                        <p>Analyzing your website, researching keywords, and building a data-driven SEO roadmap.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-bullseye flex-shrink-0"></i>
                                    <div>
                                        <h5>Implementation</h5>
                                        <p>Optimizing on-page content, meta tags, URLs, site structure, and technical SEO elements.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-palette flex-shrink-0"></i>
                                    <div>
                                        <h5>Optimization</h5>
                                        <p>Improving speed, fixing issues, enhancing backlinks, and refining keyword targeting.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-share flex-shrink-0"></i>
                                    <div>
                                        <h5>Results & Reporting</h5>
                                        <p>Providing analytics reports, ranking updates, traffic insights, and ongoing recommendations.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <div class="service-process" data-aos="fade-up" data-aos-delay="400">
                        <h4>Our Process</h4>
                        <div class="process-steps">
                            <div class="step-item">
                                <div class="step-number">01</div>
                                <div class="step-content">
                                    <h5>Strategy Development</h5>
                                    <p>Understanding your goals and creating a tailored SEO growth plan based on audience intent and competitor analysis.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">02</div>
                                <div class="step-content">
                                    <h5>Implementation</h5>

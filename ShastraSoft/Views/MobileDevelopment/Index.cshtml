@{
    ViewData["Title"] = "Mobile App Development | ShastraSoft";
    ViewData["MetaDescription"] = "Custom mobile apps by ShastraSoft. iOS, Android, cross-platform development for innovative mobile solutions.";
    ViewData["MetaKeywords"] = "mobile app development, iOS app development, Android apps, cross-platform mobile, React Native, Flutter apps, ShastraSoft mobile";
}
<!-- Page Title -->
<div class="page-title">
    <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="Javascript:void(0);"><i class="bi bi-house"></i> Home</a></li>
                <li class="breadcrumb-item active current">Mobile Development</li>
            </ol>
        </nav>
    </div>

    <div class="title-wrapper">
        <h1>Mobile Development</h1>
        <p>Innovation Engineered Into Every Tap.</p>
    </div>
</div><!-- End Page Title -->

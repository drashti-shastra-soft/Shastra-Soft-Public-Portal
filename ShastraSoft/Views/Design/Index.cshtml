    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <!-- Service Overview -->
            <div class="col-lg-8">
                <div class="service-content">
                    <h2>UI/UX Design</h2>
                    <p class="lead">We create intuitive and visually appealing UI/UX designs that deliver smooth, meaningful user experiences. By combining user research, creativity, and strong design logic, we craft interfaces that not only look great but also guide users effortlessly toward their goals.</p>

                    <div class="service-image" data-aos="fade-up" data-aos-delay="200">
                        <img src="@Url.Content("~/images/ui.jpg")" alt="Digital Marketing" class="img-fluid rounded">
                    </div>

                    <p>Our UI/UX design approach focuses on clarity, simplicity, and usability. From wireframes to final interfaces, we design digital experiences that engage users, reduce friction, and elevate your brand’s overall digital presence.</p>

                    <!-- Service Features -->
                    <div class="service-features" data-aos="fade-up" data-aos-delay="300">
                        <h4>What's Included</h4>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-graph-up-arrow flex-shrink-0"></i>
                                    <div>
                                        <h5>Strategy Development</h5>
                                        <p>Defining user goals and mapping the ideal experience.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-bullseye flex-shrink-0"></i>
                                    <div>
                                        <h5>Implementation</h5>
                                        <p>Turning research and wireframes into polished interfaces.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-palette flex-shrink-0"></i>
                                    <div>
                                        <h5>Optimization</h5>
                                        <p>Enhancing usability through testing and precision refinement.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-share flex-shrink-0"></i>
                                    <div>
                                        <h5>Results & Reporting</h5>
                                        <p>Delivering design insights, user behavior data, and performance outcomes.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <div class="service-process" data-aos="fade-up" data-aos-delay="400">
                        <h4>Our Process</h4>
                        <div class="process-steps">
                            <div class="step-item">
                                <div class="step-number">01</div>
                                <div class="step-content">
                                    <h5>Strategy Development</h5>
                                    <p>Aligning business goals with user needs for a strong foundation.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">02</div>
                                <div class="step-content">
                                    <h5>Implementation</h5>
                                    <p>Translating ideas into clean, functional UI layouts.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">03</div>
                                <div class="step-content">
                                    <h5>Optimization</h5>
                                    <p>Refining user flows for maximum clarity and ease.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">04</div>
                                <div class="step-content">
                                    <h5>Results &amp; Reporting</h5>
                                    <p>Providing clear insights to guide future improvements.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

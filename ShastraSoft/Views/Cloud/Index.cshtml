@{
    ViewData["Title"] = "Cloud Computing Solutions | ShastraSoft Cloud Services";
    ViewData["MetaDescription"] = "Secure and scalable cloud services by ShastraSoft. AWS, Azure, migration, and managed cloud solutions for business growth.";
    ViewData["MetaKeywords"] = "cloud services, cloud computing, AWS solutions, Azure services, cloud migration, managed cloud, cloud hosting, ShastraSoft cloud";
}
<!-- Page Title -->
<div class="page-title">
    <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="Javascript:void(0);"><i class="bi bi-house"></i> Home</a></li>
                <li class="breadcrumb-item active current">Cloud Service</li>
            </ol>
        </nav>
    </div>

    <div class="title-wrapper">
        <h1>Cloud Service</h1>
        <p>Our cloud solutions help businesses improve agility, reduce costs, and ensure secure operations</p>
    </div>
</div><!-- End Page Title -->
<!-- Service Details Section -->
<section id="service-details" class="service-details section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <!-- Service Overview -->
            <div class="col-lg-8">
                <div class="service-content">
                    <h2>Cloud Service</h2>
                    <p class="lead">We provide robust cloud solutions engineered to improve scalability, enhance security, and optimize performance.From cloud migration to infrastructure management and automation, we help businesses operate smarter with reliable, efficient, and future-ready cloud strategies.</p>
                    <div class="service-image" data-aos="fade-up" data-aos-delay="200">
                        <img src="@Url.Content("~/images/cloud.png")" alt="Digital Marketing" class="img-fluid rounded">
                    </div>

                    <p>We deliver advanced cloud services designed to streamline operations, reduce costs, and strengthen security. From scalable hosting to cloud integration and continuous optimization, we empower businesses to work faster with dependable, flexible, and high-performance cloud solutions.</p>

                    <!-- Service Features -->
                    <div class="service-features" data-aos="fade-up" data-aos-delay="300">
                        <h4>What's Included</h4>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-graph-up-arrow flex-shrink-0"></i>
                                    <div>
                                        <h5>Cloud Strategy Development</h5>
                                        <p>Designing a tailored cloud adoption plan aligned with your business goals and technical needs.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-bullseye flex-shrink-0"></i>
                                    <div>
                                        <h5>Cloud Implementation</h5>
                                        <p>Migrating data, deploying cloud infrastructure, and setting up secure, scalable environments.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-palette flex-shrink-0"></i>
                                    <div>
                                        <h5>Optimization</h5>
                                        <p>Boosting cloud performance through cost management, automation, and resource refinement.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-share flex-shrink-0"></i>
                                    <div>
                                        <h5>Monitoring & Reporting</h5>
                                        <p>Providing continuous monitoring, security insights, and performance-driven cloud reports.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <div class="service-process" data-aos="fade-up" data-aos-delay="400">
                        <h4>Our Process</h4>
                        <div class="process-steps">
                            <div class="step-item">
                                <div class="step-number">01</div>
                                <div class="step-content">
                                    <h5>Cloud Strategy Development</h5>
                                    <p>Assessing your requirements and creating a scalable, secure cloud architecture blueprint.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">02</div>
                                <div class="step-content">
                                    <h5>Cloud Implementation</h5>
                                    <p>Migrating applications and data while deploying reliable cloud infrastructure solutions.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">03</div>
                                <div class="step-content">
                                    <h5>Optimization</h5>
                                    <p>Improving efficiency through performance tuning, automation, and resource scaling.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">04</div>
                                <div class="step-content">
                                    <h5>Monitoring & Reporting</h5>
                                    <p>Delivering real-time analytics, cost insights, and continuous improvement recommendations.</p>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- End Service Content -->
            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar" data-aos="fade-up" data-aos-delay="200">

                    <!-- Service Quick Facts -->
                    <div class="service-info">
                        <h4>Service Details</h4>
                        <ul class="service-facts">
                            <li>
                                <span class="fact-label">Duration:</span>
                                <span class="fact-value">
                                    2–4 weeks
                                </span>
                            </li>
                            <li>
                                <span class="fact-label">Delivery:</span>
                                <span class="fact-value">Daily Reports</span>
                            </li>
                            <li>
                                <span class="fact-label">Team Size:</span>
                                <span class="fact-value">2 Specialists</span>
                            </li>
                            <li>
                                <span class="fact-label">Support:</span>
                                <span class="fact-value">24/7 Available</span>
                            </li>
                        </ul>
                    </div>

                    @* <!-- Testimonial -->
                    <div class="service-testimonial">
                        <div class="testimonial-content">
                            <p>Crafts innovative marketing approaches that connect with audiences across multiple digital channels.</p>
                            <div class="testimonial-author">
                                <img src="@Url.Content("~/images/person-m-4.jpg")" alt="Sarah Johnson" class="author-image">
                                <div class="author-info">
                                    <h5>
                                        Nova Sterling
                                    </h5>
                                    <span>Marketing Director</span>
                                </div>
                            </div>
                        </div>
                    </div> *@

                    <!-- Contact Form -->
                    <div class="inquiry-form">
                        <h4>Get a Quote</h4>
                        <form action="Javascript:void(0);" method="post" class="php-email-form">
                            <div class="form-group mb-3">
                                <input type="text" name="name" class="form-control" id="name" placeholder="Your Name" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="email" name="email" class="form-control" id="email" placeholder="Your Email" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="tel" name="phone" class="form-control" id="phone" placeholder="Your Phone">
                            </div>
                            <input type="hidden" name="subect" value="Service Quote Request">
                            <div class="form-group mb-4">
                                <textarea class="form-control" name="message" rows="5" placeholder="Tell us about your project requirements..." required=""></textarea>
                            </div>
                            <div class="loading">Loading</div>
                            <div class="error-message"></div>
                            <div class="sent-message">Your message has been sent. Thank you!</div>
                            <button type="submit" class="btn-submit w-100">Request Quote</button>
                        </form>
                    </div>

                </div>
            </div><!-- End Sidebar -->

        </div>

    </div>

</section><!-- /Service Details Section -->
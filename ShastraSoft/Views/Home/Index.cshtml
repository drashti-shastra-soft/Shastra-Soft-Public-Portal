<section id="contact" class="contact section">
    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Contact</h2>
        <p>Connect with us today and let’s start building something exceptional together</p>
    </div>
    <!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center">
            <div class="col-lg-5" data-aos="fade-right" data-aos-delay="200">
                <div class="contact-form-card">
                    <div class="form-header">
                        <div class="header-icon">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                        <h3>Let's Start a Conversation</h3>
                        <p>Whether you have a question, need a quote, or want to discuss your project, our team is ready to assist you every step of the way.</p>
                    </div>

                    <form asp-action="Index" asp-controller="Home" method="post" class="php-email-form" id="frmContactUs">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Your Name" })
                                <span class="text-danger" id="spnName"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Your Email Address", Type = "Email" })
                                <span class="text-danger" id="spnEmail"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "What's this about?" })
                            <span class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            @Html.TextAreaFor(m => m.Message, new { @class = "form-control", placeholder = "Tell us more about your project...", @rows = "4" })
                            <span class="text-danger"></span>
                        </div>
                        
                        <a href="javascript:void(0);" class="btn form-color btn-send"><i class="bi bi-send-fill"></i> Send Message</a>
                    </form>
                </div>
            </div>


            <div class="col-lg-7" data-aos="fade-left" data-aos-delay="200">
                <div class="contact-info-area">
                    <div class="info-header">
                        <h3>Ready to Transform Your Ideas?</h3>

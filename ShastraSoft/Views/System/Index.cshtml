@{
    ViewData["Title"] = "System Integration Services | ShastraSoft";
    ViewData["MetaDescription"] = "Seamless system integration by ShastraSoft. ERP, CRM, API integration for streamlined business operations.";
    ViewData["MetaKeywords"] = "system integration, ERP integration, CRM integration, API integration, enterprise integration, middleware solutions, ShastraSoft integration";
}
<!-- Page Title -->
<div class="page-title">
    <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="Javascript:void(0);"><i class="bi bi-house"></i> Home</a></li>
                <li class="breadcrumb-item active current">System Integration</li>
            </ol>
        </nav>
    </div>

    <div class="title-wrapper">
        <h1>System Integration</h1>
        <p>We integrate systems and applications to ensure smooth data flow and reliable digital experiences</p>
    </div>
</div><!-- End Page Title -->
<!-- Service Details Section -->
<section id="service-details" class="service-details section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <!-- Service Overview -->
            <div class="col-lg-8">
                <div class="service-content">
                    <h2>System Integration</h2>
                    <p class="lead">
                        We build powerful, user-friendly system integrations designed for speed, reliability, and seamless connectivity. Our solutions ensure smooth data flow with intuitive APIs that enhance interoperability.
                    </p>
                    <div class="service-image" data-aos="fade-up" data-aos-delay="200">
                        <img src="@Url.Content("~/images/system.png")" alt="System Integration" class="img-fluid rounded">
                    </div>

                    <p>
                        We create robust, seamless system integrations built for speed, reliability, and effortless connectivity. Our solutions deliver smooth data synchronization with intuitive interfaces that boost efficiency.
                    </p>

                    <!-- Service Features -->
                    <div class="service-features" data-aos="fade-up" data-aos-delay="300">
                        <h4>What's Included</h4>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-diagram-3 flex-shrink-0"></i>
                                    <div>
                                        <h5>Integration Planning</h5>
                                        <p>Mapping APIs, databases, and systems to create seamless connectivity across platforms.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-plug flex-shrink-0"></i>
                                    <div>
                                        <h5>Development & Implementation</h5>
                                        <p>Building robust connectors, middleware, and APIs for reliable data flow and automation.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-speedometer2 flex-shrink-0"></i>
                                    <div>
                                        <h5>Optimization</h5>
                                        <p>Streamlining data transfer, reducing latency, and ensuring secure, scalable integrations.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-shield-check flex-shrink-0"></i>
                                    <div>
                                        <h5>Monitoring & Maintenance</h5>
                                        <p>Real-time monitoring, error handling, and continuous updates for system reliability.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <div class="service-process" data-aos="fade-up" data-aos-delay="400">
                        <h4>Our Process</h4>
                        <div class="process-steps">
                            <div class="step-item">
                                <div class="step-number">01</div>
                                <div class="step-content">
                                    <h5>Integration Planning</h5>
                                    <p>Analyzing systems, defining APIs, and creating integration architecture blueprints.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">02</div>
                                <div class="step-content">
                                    <h5>Development</h5>
                                    <p>Implementing secure connectors, data synchronization, and real-time integration workflows.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">03</div>
                                <div class="step-content">
                                    <h5>Optimization</h5>
                                    <p>Performance tuning, security hardening, and scalability testing across all systems.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">04</div>
                                <div class="step-content">
                                    <h5>Monitoring & Maintenance</h5>
                                    <p>Proactive monitoring, automated failover, and ongoing compatibility updates.</p>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
            </div><!-- End Service Content -->
            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar" data-aos="fade-up" data-aos-delay="200">

                    <!-- Service Quick Facts -->
                    <div class="service-info">
                        <h4>Service Details</h4>
                        <ul class="service-facts">
                            <li>
                                <span class="fact-label">Duration:</span>
                                <span class="fact-value">
                                    2–4 weeks
                                </span>
                            </li>
                            <li>
                                <span class="fact-label">Delivery:</span>
                                <span class="fact-value">Daily Reports</span>
                            </li>
                            <li>
                                <span class="fact-label">Team Size:</span>
                                <span class="fact-value">2 Specialists</span>
                            </li>
                            <li>
                                <span class="fact-label">Support:</span>
                                <span class="fact-value">24/7 Available</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Testimonial -->
                    <div class="service-testimonial">
                        <div class="testimonial-content">
                            <p>Crafts innovative marketing approaches that connect with audiences across multiple digital channels.</p>
                            <div class="testimonial-author">
                                <img src="@Url.Content("~/images/person-m-4.jpg")" alt="Sarah Johnson" class="author-image">
                                <div class="author-info">
                                    <h5>
                                        Nova Sterling
                                    </h5>
                                    <span>Marketing Director</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form -->
                    <div class="inquiry-form">
                        <h4>Get a Quote</h4>
                        <form action="Javascript:void(0);" method="post" class="php-email-form">
                            <div class="form-group mb-3">
                                <input type="text" name="name" class="form-control" id="name" placeholder="Your Name" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="email" name="email" class="form-control" id="email" placeholder="Your Email" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="tel" name="phone" class="form-control" id="phone" placeholder="Your Phone">
                            </div>
                            <input type="hidden" name="subect" value="Service Quote Request">
                            <div class="form-group mb-4">
                                <textarea class="form-control" name="message" rows="5" placeholder="Tell us about your project requirements..." required=""></textarea>
                            </div>
                            <div class="loading">Loading</div>
                            <div class="error-message"></div>
                            <div class="sent-message">Your message has been sent. Thank you!</div>
                            <button type="submit" class="btn-submit w-100">Request Quote</button>
                        </form>
                    </div>

                </div>
            </div><!-- End Sidebar -->

        </div>

    </div>

</section><!-- /Service Details Section -->
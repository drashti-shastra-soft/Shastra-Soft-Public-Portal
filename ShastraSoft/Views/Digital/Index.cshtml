@{
    ViewData["Title"] = "Digital Marketing | ShastraSoft";
    ViewData["MetaDescription"] = "Boost your online presence with ShastraSoft's digital marketing services. SEO, PPC, social media, and content strategies for maximum ROI.";
    ViewData["MetaKeywords"] = "digital marketing, digital marketing agency, SEO services, PPC advertising, social media marketing, content marketing, ShastraSoft digital";
}
<!-- Page Title -->
<div class="page-title">
    <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="Javascript:void(0);"><i class="bi bi-house"></i> Home</a></li>
                <li class="breadcrumb-item active current">Digital Marketing</li>
            </ol>
        </nav>
    </div>

    <div class="title-wrapper">
        <h1>Digital Marketing</h1>
        <p>Driving Growth Through Data-Driven Marketing</p>
    </div>
</div><!-- End Page Title -->
<!-- Service Details Section -->
<section id="service-details" class="service-details section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <!-- Service Overview -->
            <div class="col-lg-8">
                <div class="service-content">
                    <h2>Digital Marketing</h2>
                    <p class="lead"> We deliver data-driven digital marketing solutions designed to increase visibility, boost engagement, and drive measurable results. From SEO to social media and performance marketing, we help brands grow faster with targeted strategies that truly work.</p>
                    <div class="service-image" data-aos="fade-up" data-aos-delay="200">
                        <img src="@Url.Content("~/images/ditigal.jpg")" alt="Digital Marketing" class="img-fluid rounded">
                    </div>

                    <p>Our digital marketing approach blends creativity with analytics to build powerful campaigns across all digital channels. We create strategies that elevate your brand, attract the right audience, and generate consistent, meaningful conversions.</p>

                    <!-- Service Features -->
                    <div class="service-features" data-aos="fade-up" data-aos-delay="300">
                        <h4>What's Included</h4>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-graph-up-arrow flex-shrink-0"></i>
                                    <div>
                                        <h5>Strategy Development</h5>
                                        <p>Creating a customized marketing roadmap based on audience research and brand goals.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-bullseye flex-shrink-0"></i>
                                    <div>
                                        <h5>Implementation</h5>
                                        <p>Launching campaigns across SEO, social media, ads, and content marketing.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-palette flex-shrink-0"></i>
                                    <div>
                                        <h5>Optimization</h5>
                                        <p>Monitoring performance, refining strategies, and improving ROI.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-item">
                                    <i class="bi bi-share flex-shrink-0"></i>
                                    <div>
                                        <h5>Results & Reporting</h5>
                                        <p>Providing detailed analytics, insights, and growth-focused reports.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <div class="service-process" data-aos="fade-up" data-aos-delay="400">
                        <h4>Our Process</h4>
                        <div class="process-steps">
                            <div class="step-item">
                                <div class="step-number">01</div>
                                <div class="step-content">
                                    <h5>Strategy Development</h5>
                                    <p>Understanding your audience and crafting a high-impact digital growth plan.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">02</div>
                                <div class="step-content">
                                    <h5>Implementation</h5>
                                    <p>
                                        Executing creative and performance-driven marketing campaigns across platforms.
                                    </p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">03</div>
                                <div class="step-content">
                                    <h5>Optimization</h5>
                                    <p>Analyzing results and enhancing campaigns for stronger conversions and reach.</p>
                                </div>
                            </div>
                            <div class="step-item">
                                <div class="step-number">04</div>
                                <div class="step-content">
                                    <h5>Results Reporting</h5>
                                    <p>Delivering clear metrics, success reports, and future growth recommendations.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div><!-- End Service Content -->
            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar" data-aos="fade-up" data-aos-delay="200">

                    <!-- Service Quick Facts -->
                    <div class="service-info">
                        <h4>Service Details</h4>
                        <ul class="service-facts">
                            <li>
                                <span class="fact-label">Duration:</span>
                                <span class="fact-value">
                                    - 2–4 weeks
                                </span>
                            </li>
                            <li>
                                <span class="fact-label">Delivery:</span>
                                <span class="fact-value">Daily Reports</span>
                            </li>
                            <li>
                                <span class="fact-label">Team Size:</span>
                                <span class="fact-value">2 Specialists</span>
                            </li>
                            <li>
                                <span class="fact-label">Support:</span>
                                <span class="fact-value">24/7 Available</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Testimonial -->
                    @* <div class="service-testimonial">
                        <div class="testimonial-content">
                            <p>Crafts innovative marketing approaches that connect with audiences across multiple digital channels.</p>
                            <div class="testimonial-author">
                                <img src="@Url.Content("~/images/person-m-4.jpg")" alt="Sarah Johnson" class="author-image">
                                <div class="author-info">
                                    <h5>Nova Sterling
                                    </h5>
                                    <span>Marketing Director</span>
                                </div>
                            </div>
                        </div>
                    </div> *@

                    <!-- Contact Form -->
                    <div class="inquiry-form">
                        <h4>Get a Quote</h4>
                        <form action="Javascript:void(0);" method="post" class="php-email-form">
                            <div class="form-group mb-3">
                                <input type="text" name="name" class="form-control" id="name" placeholder="Your Name" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="email" name="email" class="form-control" id="email" placeholder="Your Email" required="">
                            </div>
                            <div class="form-group mb-3">
                                <input type="tel" name="phone" class="form-control" id="phone" placeholder="Your Phone">
                            </div>
                            <input type="hidden" name="subect" value="Service Quote Request">
                            <div class="form-group mb-4">
                                <textarea class="form-control" name="message" rows="5" placeholder="Tell us about your project requirements..." required=""></textarea>
                            </div>
                            <div class="loading">Loading</div>
                            <div class="error-message"></div>
                            <div class="sent-message">Your message has been sent. Thank you!</div>
                            <button type="submit" class="btn-submit w-100">Request Quote</button>
                        </form>
                    </div>

                </div>
            </div><!-- End Sidebar -->

        </div>

    </div>

</section><!-- /Service Details Section -->